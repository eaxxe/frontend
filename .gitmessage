# <type>: <short summary>
# (до ~50 символов, в повелительном наклонении)

# Why:
# Почему это изменение нужно?

# What:
# Что конкретно было сделано?

# Notes (optional):
# Дополнительные детали, ограничения, побочные эффекты

# Issue (optional):
# #123

#################################################################
# <type>:
# feat — новая функциональность
# fix — исправление бага
# refactor — рефакторинг без изменения поведения
# docs — изменения в документации
# test — тесты
# chore — технические изменения (зависимости, конфиги)
#
# example:
# 
# feat: add pagination to users API
# 
# Why:
# API возвращал сразу всех пользователей, что плохо
# масштабируется и замедляет ответы.
# 
# What:
# - добавлены параметры limit и offset
# - обновлён endpoint /api/users
# - добавлена базовая валидация параметров
# 
# Notes:
# старое поведение сохранено по умолчанию (limit=50)
# 
# Issue:
# #142
